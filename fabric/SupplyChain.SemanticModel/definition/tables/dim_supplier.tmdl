table dim_supplier

	column supplier_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: supplier_key

	column supplier_code
		dataType: string
		summarizeBy: none
		sourceColumn: supplier_code

	column supplier_name
		dataType: string
		summarizeBy: none
		sourceColumn: supplier_name

	column country
		dataType: string
		summarizeBy: none
		sourceColumn: country

	partition dim_supplier = entity
		mode: directLake
		source
			entityName: dim_supplier
			schemaName: dbo
			expressionSource: DatabaseQuery

