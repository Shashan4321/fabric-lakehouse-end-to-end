table dim_warehouse

	column warehouse_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: warehouse_key

	column warehouse_code
		dataType: string
		summarizeBy: none
		sourceColumn: warehouse_code

	column warehouse_name
		dataType: string
		summarizeBy: none
		sourceColumn: warehouse_name

	column region
		dataType: string
		summarizeBy: none
		sourceColumn: region

	partition dim_warehouse = entity
		mode: directLake
		source
			entityName: dim_warehouse
			schemaName: dbo
			expressionSource: DatabaseQuery

