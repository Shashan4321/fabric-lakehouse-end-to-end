table fact_po_line

	/// Number of purchase-order lines.
	measure 'PO Lines' = COUNTROWS ( fact_po_line )
		formatString: #,0
		displayFolder: Volume

	/// Ordered quantity x unit price.
	measure 'Order Value' = SUM ( fact_po_line[order_value] )
		formatString: ₹ #,0
		displayFolder: Value

	/// Received quantity x unit price.
	measure 'Received Value' = SUM ( fact_po_line[received_value] )
		formatString: ₹ #,0
		displayFolder: Value

	/// PO lines with at least one receipt.
	measure 'Delivered Lines' = CALCULATE ( COUNTROWS ( fact_po_line ), NOT ISBLANK ( fact_po_line[first_receipt_date] ) )
		formatString: #,0
		displayFolder: Volume

	/// Share of delivered lines received in full on or before the promised date.
	measure 'OTIF %' = DIVIDE ( SUM ( fact_po_line[is_otif] ), [Delivered Lines] )
		formatString: 0.0%
		displayFolder: Supplier Performance

	/// First receipt on or before the promised date.
	measure 'On-Time %' = DIVIDE ( SUM ( fact_po_line[is_on_time] ), [Delivered Lines] )
		formatString: 0.0%
		displayFolder: Supplier Performance

	/// Total received quantity >= ordered quantity.
	measure 'In-Full %' = DIVIDE ( SUM ( fact_po_line[is_in_full] ), [Delivered Lines] )
		formatString: 0.0%
		displayFolder: Supplier Performance

	/// Days from order to first receipt.
	measure 'Avg Lead Time (days)' = AVERAGE ( fact_po_line[lead_time_days] )
		formatString: 0.0
		displayFolder: Supplier Performance

	/// OTIF in the same period last year.
	measure 'OTIF % PY' = CALCULATE ( [OTIF %], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: 0.0%
		displayFolder: Supplier Performance

	/// Change in OTIF vs last year, in percentage points.
	measure 'OTIF Change (pts)' = IF ( NOT ISBLANK ( [OTIF % PY] ), ( [OTIF %] - [OTIF % PY] ) * 100 )
		formatString: +0.0;-0.0;0.0
		displayFolder: Supplier Performance

	/// 1 = worst OTIF in the current selection (who to call first).
	measure 'Supplier OTIF Rank' =
			IF (
				HASONEVALUE ( dim_supplier[supplier_code] ),
				RANKX ( ALLSELECTED ( dim_supplier[supplier_code] ), [OTIF %],, ASC, DENSE )
			)
		formatString: 0
		displayFolder: Supplier Performance

	column po_number
		dataType: string
		summarizeBy: none
		sourceColumn: po_number

	column po_line
		dataType: int64
		summarizeBy: none
		sourceColumn: po_line

	column supplier_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: supplier_key

	column item_key
