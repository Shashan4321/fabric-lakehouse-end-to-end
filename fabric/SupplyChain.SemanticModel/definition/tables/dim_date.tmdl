table dim_date
	dataCategory: Time

	column date
		dataType: dateTime
		isKey
		summarizeBy: none
		sourceColumn: date

	column date_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_key

	column year
		dataType: int64
		summarizeBy: none
		sourceColumn: year

	column month
		dataType: int64
		summarizeBy: none
		sourceColumn: month

	column month_name
		dataType: string
		sortByColumn: month
		summarizeBy: none
		sourceColumn: month_name

	column year_month
		dataType: int64
		summarizeBy: none
		sourceColumn: year_month

	column quarter
		dataType: int64
		summarizeBy: none
		sourceColumn: quarter

	column fiscal_year
		dataType: int64
		summarizeBy: none
		sourceColumn: fiscal_year

	partition dim_date = entity
		mode: directLake
		source
			entityName: dim_date
			schemaName: dbo
			expressionSource: DatabaseQuery

